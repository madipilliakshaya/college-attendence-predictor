# ─────────────────────────────────────────────────────────
#  College Attendance Predictor — Backend Environment Config
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# SQLite (zero-config local dev — default if not set)
DATABASE_URL=sqlite:///./attendance_predictor.db

# PostgreSQL / Supabase production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/attendance_predictor

# Supabase project URL & anon key (only needed for Supabase RLS features)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key-here

# ── Security ──────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-in-production

# JWT expiry in minutes (default 60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ───────────────────────────────────────────────────
APP_NAME=College Attendance Predictor
DEBUG=false

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
